{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "mozPipelineMetadata": {
    "expiration_policy": {
      "delete_after_days": 400
    }
  },
  "type": "object",
  "title": "downgrade",
  "properties": {
    @TELEMETRY_ID_1_JSON@,
    @TELEMETRY_CREATIONDATE_1_JSON@,
    @TELEMETRY_APPLICATION_1_JSON@,
    @TELEMETRY_CLIENTID_1_JSON@,
    "type": {
      "type": "string",
      "enum": [ "downgrade" ]
    },
    "version": {
      "type": "number",
      "minimum": 4,
      "maximum": 4
    },
    "payload": {
      "type": "object",
      "properties": {
        "lastVersion": {
          "type": "string",
          "pattern": "^[0-9]{2,3}\\.",
          "description": "The previous version that used this profile"
        },
        "lastBuildId": {
          "type": "string",
          "pattern": "^[0-9]{10}",
          "description": "The previous build ID that used this profile"
        },
        "hasSync": {
          "type": "boolean",
          "description": "Whether this profile is signed into sync"
        },
        "button": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "description": "The button clicked in the downgrade dialog"
        },
        "isMSIX": {
          "type": "boolean",
          "description": "Whether this application was installed from MSIX"
        },
        "isBackgroundTaskModeRequested": {
          "type": "boolean",
          "description": "No longer used"
        },
        "isBackgroundTaskMode": {
          "type": "boolean",
          "description": "No longer used"
        },
        "hasRestartPidParameter": {
          "type": "boolean",
          "description": "No longer used"
        },
        "isRestartPidNotInteger": {
          "type": "boolean",
          "description": "No longer used"
        },
        "isRestartPidWaitTimeout": {
          "type": "boolean",
          "description": "No longer used"
        },
        "isRestartPidFailure": {
          "type": "boolean",
          "description": "No longer used"
        },
        "profileSelectionReason": {
          "type": "string",
          "description": "How the profile manager picked a profile to use during startup"
        },
        "isDifferentInstall": {
          "type": "boolean",
          "description": "Whether the profile was previously used by a different install"
        },
        "isNewInstall": {
          "type": "boolean",
          "description": "Whether the application was installed since the profile was last used"
        },
        "isNewUpdate": {
          "type": "boolean",
          "description": "Whether the application was updated since the profile was last used"
        },
        "daysSinceLock": {
          "type": "number",
          "description": "The number of days since the profile was last started"
        }
      },
      "required": [
        "lastVersion",
        "hasSync",
        "button"
      ]
    }
  },
  "required": [
    "type",
    "id",
    "creationDate",
    "version",
    "application",
    "clientId",
    "payload"
  ]
}
